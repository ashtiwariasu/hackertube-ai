[Unit]
Description=hackertube Bluesky YouTube-link collector (Jetstream v2)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/packs/bluesky
ExecStart=%h/packs/bluesky/.venv/bin/python -u %h/packs/bluesky/collector.py
Restart=always
RestartSec=10
Nice=10
CPUQuota=50%
MemoryMax=1G
IOSchedulingClass=idle
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
