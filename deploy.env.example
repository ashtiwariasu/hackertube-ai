# Copy to deploy.env (git-ignored) and fill in. deploy.sh sources this file with bash, so ${VAR-default}
# lets a value given on the command line win, e.g. `PILOT_TOPIC= ./deploy.sh` switches pay off for one deploy.

# Google Cloud
PROJECT=your-gcp-project
REGION=us-central1
SERVICE=hackertube-ai
BASE_URL=https://your-domain.example
DATA_BUCKET=                      # bucket for weekly catalogue releases (optional; without it the image's own data is used)
MEMORY=4Gi                        # about 10 KB of RAM per catalogue video, doubled while a new release loads
MIN_INSTANCES=1

# Who runs the site, shown on the About, Privacy and Terms pages
OPERATOR_NAME=
OPERATOR_PLACE=
OPERATOR_CONTACT=

SOURCE_URL=https://github.com/ashtiwariasu/hackertube-ai   # the "Source code" link; point it at your fork

# Payments and analytics (all optional; leave empty to switch off)
STRIPE_PRICE_ID=                  # a one-time price for Pro
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
GA_MEASUREMENT_ID=

# Reviews, ratings and the Partner Program. HT_NOTES=1 switches reviews on; PILOT_TOPIC switches pay on for
# one topic id (or * for every video); leave it empty for unpaid reviews only.
HT_NOTES=${HT_NOTES:-0}
PILOT_TOPIC=${PILOT_TOPIC-}
HACKER_AUTO_APPROVE=${HACKER_AUTO_APPROVE:-0}
PARTNER_CAP_USD=1000

# Secrets are read from Secret Manager in PROJECT when they exist: hackertube-session-secret (required),
# STRIPE_SECRET_KEY, ANTHROPIC_API_KEY, hackertube-youtube-api-key, hackertube-stripe-webhook-secret,
# hackertube-google-client-id / -secret, hackertube-handle-salt, hackertube-admin-uids.
